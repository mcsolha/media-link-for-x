{
  "name": "media-link-for-x",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:network": "vitest run --config vitest.network.config.ts",
    "zip": "npm run build && node zip.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  },
  "description": "Media Link for X: copia o link da mídia de posts no x.com. Não afiliado à X Corp.",
  "license": "MIT",
  "author": "Matheus Coelho Solha",
  "repository": {
    "type": "git",
    "url": "https://github.com/mcsolha/media-link-for-x.git"
  }
}
