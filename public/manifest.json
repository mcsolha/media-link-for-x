{
  "manifest_version": 3,
  "name": "X Media Link",
  "version": "1.0.0",
  "description": "Copia o link da mídia (…/photo/N, …/video/N) de posts no x.com, como no app mobile.",
  "permissions": ["clipboardWrite"],
  "host_permissions": ["https://cdn.syndication.twimg.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://x.com/*", "https://twitter.com/*", "https://mobile.x.com/*", "https://mobile.twitter.com/*"],
    "js": ["content.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }]
}
